# Copy to `backend/.env.local` and fill in. Restart the server after editing.
# .env.local is gitignored. Never commit keys; the browser never sees them.

# Agora RTC/RTM + Conversational AI Engine (console.agora.io)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Murf Falcon TTS (agent voice via Agora + nurse voice via /voice/tts)
MURF_API_KEY=
MURF_REGION=global
# Falcon voice ids (list: GET https://api.murf.ai/v1/speech/voices?model=falcon-2.1)
# MURF_VOICE_MALE=en-IN-aarav
# MURF_VOICE_FEMALE=en-IN-priya
# MURF_NURSE_VOICE=en-IN-anisha

# LLMs (OpenAI-compatible). Patient voice, nurse agent and simple debrief.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
GROQ_API_KEY=
# openai/gpt-oss-20b is the only Groq model enabled on this key (llama-3.3-70b-versatile 404s)
GROQ_MODEL=openai/gpt-oss-20b
# sarvam (default) | groq | managed (Agora-managed OpenAI, patient voice only)
PATIENT_LLM_PROVIDER=sarvam
# Patient LLM via our /llm proxy (drops blank noise turns Sarvam rejects). Agora's
# cloud needs an HTTPS URL for this backend. Either set a fixed one:
# PUBLIC_URL=https://your-tunnel.example.com
# or let the server spawn a cloudflared quick tunnel on startup:
# PATIENT_LLM_TUNNEL=cloudflared
# Unset = Agora calls Sarvam directly. Port the server listens on (tunnel target):
# BACKEND_PORT=8787
# Speech recognition inside Agora: sarvam (default, needs SARVAM_API_KEY) | ares
VOICE_ASR=sarvam

# OPTIONAL: Claude Managed Agents attending + triage + text chat only.
ANTHROPIC_API_KEY=
MEDSIM_AGENT_ID=
MEDSIM_ENV_ID=

# OPTIONAL: send the prescription + voice link + follow-up to the patient (free tiers only).
# Twilio WhatsApp sandbox / trial SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox sender, defaults to +14155238886
TWILIO_WHATSAPP_FROM=
# Only for SMS (a Twilio trial number)
TWILIO_SMS_FROM=
# Email via SMTP over SSL (Gmail: use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER
SMTP_FROM=

# Telegram (free, recommended for the demo): create a bot with @BotFather and paste its token.
# The patient opens t.me/<your_bot>?start=medsim and presses Start; then contact "telegram" works.
TELEGRAM_BOT_TOKEN=
# Where Asha's live red-flag alerts go during a follow-up call: "telegram", tg:<chat id>,
# a phone (E.164) or an email. Blank = the patient's contact on file. Needs PUBLIC_URL or
# PATIENT_LLM_TUNNEL so Agora reaches the /llm proxy where Asha's tools run.
DOCTOR_ALERT_DEST=

# Optional lip-synced video avatar for the teacher and viva examiner (Agora ConvoAI avatar).
# Leave blank to keep the 3D teacher / pixel examiner. Free no-card key: https://lab.anam.ai
# (Anam free plan, 30 min/month). Vendor: anam | liveavatar | akool.
AVATAR_VENDOR=
AVATAR_API_KEY=
# Avatar id from the vendor's gallery or dashboard
AVATAR_ID=
# high | medium | low (anam, liveavatar)
AVATAR_QUALITY=
# Optional: Twilio Content template SID for WhatsApp (required on trial accounts)
TWILIO_WHATSAPP_CONTENT_SID=
